# Public — safe for a browser/anon client, RLS-bound
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Secret — bypasses RLS. Server-side / internal tooling only.
# Also relies on `internal` schema never being added to db.schemas in supabase/config.toml,
# so tables like status_change_event stay unreachable via PostgREST/GraphQL even with this key.
SUPABASE_SERVICE_ROLE_KEY=
