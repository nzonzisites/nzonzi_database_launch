{
  "name": "nzonzi-db",
  "private": true,
  "version": "0.1.0",
  "description": "Supabase schema, migrations, and typed DB access for Nzonzi. No app framework — data layer only.",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > db/types/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^1.226.4",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}
